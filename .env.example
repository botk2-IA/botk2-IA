# ── BASE DE DATOS ─────────────────────────────────────────────────
# Railway lo setea automáticamente al agregar el plugin PostgreSQL.
# En local no es necesario (usa SQLite por defecto).
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── SEGURIDAD ─────────────────────────────────────────────────────
# Clave secreta para firmar las sesiones. OBLIGATORIA en producción:
# sin ella se usa una clave temporal y las sesiones se pierden en cada reinicio.
# Generá una con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria

# ── PANEL ADMIN ───────────────────────────────────────────────────
# SHA-256 de la contraseña del panel /admin.
# Sin esta variable el panel admin queda deshabilitado (no hay contraseña por defecto).
# Generá con: python -c "import hashlib; print(hashlib.sha256(b'tu_pass').hexdigest())"
ADMIN_PASSWORD_HASH=

# ── URL PÚBLICA DE LA APP ─────────────────────────────────────────
# Se usa para armar las URLs de retorno de MercadoPago y Stripe
APP_URL=https://tu-app.railway.app

# ── MERCADOPAGO (Argentina y LATAM) ───────────────────────────────
# Conseguilo en: https://www.mercadopago.com.ar/developers/panel
# Usá el Access Token de PRODUCCIÓN (empieza con APP_USR-)
# o el de SANDBOX (APP_USR-... de prueba) para testear
MP_ACCESS_TOKEN=APP_USR-xxxxxxxxxxxxxxxxxxxx

# ── STRIPE (Internacional) ────────────────────────────────────────
# Conseguilo en: https://dashboard.stripe.com/apikeys
# sk_test_... para pruebas / sk_live_... para producción
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx
# Conseguilo en Stripe → Developers → Webhooks → tu endpoint → Signing secret
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx

# ── WHATSAPP (Meta Cloud API) ─────────────────────────────────────
# App Secret de tu app en developers.facebook.com → Configuración → Básica.
# Con esto el webhook rechaza mensajes que no vengan firmados por Meta.
WHATSAPP_APP_SECRET=
# Token que escribís en Meta al configurar el webhook (elegí uno propio)
WHATSAPP_VERIFY_TOKEN=

# ── WHATSAPP vía Twilio (alternativa) ─────────────────────────────
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ── COPIAS DE SEGURIDAD AUTOMÁTICAS (opcional) ────────────────────
# Con estas variables la app sube una copia completa por día (3:30 AM)
# a un bucket S3, Cloudflare R2 o Backblaze B2. El bucket debe ser PRIVADO.
# BACKUP_S3_BUCKET=
# BACKUP_S3_ACCESS_KEY=
# BACKUP_S3_SECRET_KEY=
# BACKUP_S3_ENDPOINT=        (necesaria si no es AWS, ej. R2 o B2)
# BACKUP_S3_REGION=auto

# ── CIFRADO DE DATOS SENSIBLES ────────────────────────────────────
# Cifra en la base DNI, notas, diagnóstico, observaciones, receta y el
# token de WhatsApp de cada clínica. Al configurarla, la app cifra sola
# los datos existentes en el siguiente arranque.
# Generá con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ¡Guardá una copia fuera de Railway! Si se pierde, los datos cifrados no se recuperan.
DATA_ENCRYPTION_KEY=
